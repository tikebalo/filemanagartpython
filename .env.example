# Application
APP_NAME=FileManager Pro
APP_VERSION=1.0.0
DEBUG=False

# Security
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite:///./storage/database.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/filemanager

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=5368709120
DEFAULT_USER_QUOTA=5368709120
TRASH_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin (first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
